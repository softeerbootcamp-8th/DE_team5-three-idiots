# =========================================================
# Airflow / Docker Compose
# =========================================================
POSTGRES_USER=airflow
POSTGRES_PASSWORD=
POSTGRES_DB=airflow

AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Airflow 3.x 컴포넌트가 함께 사용하는 JWT secret.
# 운영에서는 충분히 긴 무작위 문자열을 설정한다.
AIRFLOW__API_AUTH__JWT_SECRET=

# CI가 ECR에 push한 이미지 주소. 비우면 로컬에서 Dockerfile을 빌드한다.
# 예: 123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/three-idiots-airflow:latest
AIRFLOW_IMAGE=

# =========================================================
# 실행 환경 / AWS
# =========================================================
# "aws": S3, RDS, Spark 클러스터 사용
# "local": 로컬 디스크, SQLite, Spark local[*] 사용
APP_ENV=aws

AWS_REGION=ap-northeast-2
S3_BUCKET_DATA=

# Type 3 요일별 승차 수요 평균에 사용할 최근 주 수
TLC_TYPE3_ROLLING_WEEKS=12

# =========================================================
# RDS (세그먼트 지표 서빙 테이블) — DynamoDB 사용 중단으로 전환
# =========================================================
# 비워두면 docker-compose가 로컬 postgres 서비스(POSTGRES_*)를 그대로
# 재사용한다 — 새 RDS 인스턴스 없이 로컬 개발이 가능하다. 운영에서는
# 실제 RDS 엔드포인트/자격증명으로 채운다.
RDS_HOST=
RDS_PORT=
RDS_DB=
RDS_USER=
RDS_PASSWORD=

# 비워두면 docker-compose가 segment_metrics_type1/2/3/4로 자동 대체
SERVING_TABLE_TYPE1=
SERVING_TABLE_TYPE2=
SERVING_TABLE_TYPE3=
SERVING_TABLE_TYPE4=

# =========================================================
# EMR Serverless
# =========================================================
# 세그먼트 지표 파이프라인 Spark 잡 실행 대상
# 의존성 패키징은 scripts/package_emr_dependencies.sh로 별도 실행 필요
EMR_APPLICATION_ID=
EMR_JOB_ROLE_ARN=

# =========================================================
# 장애 알림
# =========================================================
# Slack Incoming Webhook URL. 운영 EC2에서는 반드시 실제 값을 설정한다.
SLACK_WEBHOOK_URL=

# =========================================================
# Grafana (모니터링 대시보드)
# =========================================================
# CloudWatch 데이터소스는 EC2 인스턴스 IAM 롤(CloudWatchReadOnlyAccess)을
# 그대로 쓰므로 별도 AWS 키가 필요 없다 - 여기 아래 두 값만 채우면 된다.
# GRAFANA_ADMIN_PASSWORD는 비워두면 컨테이너가 기동을 거부한다(기본값
# admin/admin으로 공개 노출되는 걸 막기 위함).
GRAFANA_ADMIN_USERNAME=admin
GRAFANA_ADMIN_PASSWORD=
